    <!-- Featured-article popup teaser -->
    <!-- Background hymn: no visible player. The iframe is created only when
         the reader clicks the popup teaser (a user gesture, so sound is
         allowed) and lives offscreen. data-vid comes from featured.json
         (audio.id) or this baked default. -->
