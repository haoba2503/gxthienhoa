<!DOCTYPE html>
<!-- News section + daily auto-update via GitHub Actions -->
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giáo Xứ Đại Hải</title>
    <link rel="icon" href="images/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="images/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="images/apple-touch-icon.png">
    <link rel="stylesheet" href="style.css?v=20260830a">
    <style id="hero-critical">
      /* SINGLE SOURCE OF TRUTH for hero LAYOUT + sound toggle.
         Inlined so the geometry ships in the same response as the markup and can
         never be served stale relative to it (this is what prevents the
         "mini-box" bug). Edit hero layout HERE, not in style.css. */
      .hero{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;text-align:center;height:100vh;height:100svh;min-height:600px;background:linear-gradient(135deg,rgba(15,118,110,.72),rgba(13,148,136,.55)),url(https://i.ytimg.com/vi/59kCnuT1m1M/maxresdefault.jpg);background-size:cover;background-position:center;}
      .hero-video{position:absolute;top:0;right:0;bottom:0;left:0;z-index:0;overflow:hidden;pointer-events:none;opacity:0;transition:opacity 1s ease;}
      .hero.video-ready .hero-video{opacity:1;}
      /* Cover math: the double-min keeps a 16:9 box covering EVERY aspect ratio.
         min-* deliberately use vh (largest viewport) so no seam appears when the
         iOS toolbar collapses. scale(1.01) masks YouTube's own edge bars. */
      .hero-video iframe,.hero-video #hero-player{position:absolute!important;top:50%!important;left:50%!important;transform:translate(-50%,-50%) scale(1.28)!important;width:100vw!important;height:56.25vw!important;min-height:100vh!important;min-width:177.7778vh!important;border:0!important;pointer-events:none!important;}
      /* Lighter tint so the video shows clearly; a soft dark pool behind the
         centered text keeps the title/buttons readable. */
      .hero-overlay{position:absolute;top:0;right:0;bottom:0;left:0;z-index:1;transition:opacity .8s ease;background:linear-gradient(to bottom,rgba(0,0,0,.38) 0%,rgba(0,0,0,0) 22%),radial-gradient(ellipse 80% 55% at 50% 52%,rgba(0,0,0,.5),rgba(0,0,0,0) 68%),linear-gradient(to bottom,rgba(15,118,110,.22) 0%,rgba(13,148,136,.16) 45%,rgba(15,118,110,.45) 100%);}
      .hero-content{position:relative;z-index:2;max-width:800px;padding:0 20px;color:#fff;transition:opacity .8s ease,visibility .8s ease;}
      /* After a few seconds the title/buttons fade out for a clean view of the
         video; any mouse/touch/scroll/key interaction brings them back (JS). */
      .hero.hero-dimmed .hero-content{opacity:0;visibility:hidden;}
      .hero.hero-dimmed .hero-overlay{opacity:.4;}
      /* Toggle visibility depends ONLY on the [hidden] attribute (toggled by JS),
         never on .video-ready — so it can't get stuck hidden on a slow network. */
      .hero-sound-toggle{position:absolute;bottom:30px;right:30px;z-index:5;width:52px;height:52px;border-radius:50%;border:2px solid rgba(255,255,255,.7);background:rgba(15,118,110,.5);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);transition:transform .25s ease,background .25s ease,opacity .25s ease;}
      .hero-sound-toggle[hidden]{display:none;}
      .hero-sound-toggle.is-loading{opacity:.55;pointer-events:none;}
      .hero-sound-toggle.active{background:#fbbf24;border-color:#fbbf24;}
      .hero-sound-toggle:hover{background:#fbbf24;border-color:#fbbf24;transform:scale(1.08);}
      .hero-sound-toggle:focus-visible{outline:3px solid #fbbf24;outline-offset:3px;}
      .hero-sound-toggle .hst-icon{width:24px;height:24px;display:block;}
      .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}
      @media (max-width:768px){.hero-sound-toggle{width:46px;height:46px;bottom:20px;right:20px;}.hero-sound-toggle .hst-icon{width:21px;height:21px;}}
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
